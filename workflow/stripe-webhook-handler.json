      "name": "Webhook",
      "webhookId": "0b66e435-a8be-4ca0-91c2-71b002a3b6c8"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst WEBHOOK_SECRET = $env.STRIPE_WEBHOOK_SECRET;\n\nconst item = $input.first();\nconst headers = item.json.headers;\n\nconst sigHeader = headers['stripe-signature'];\nif (!sigHeader) {\n  return [{ json: { valid: false, error: 'Missing Stripe-Signature header' } }];\n}\n\nconst binaryKeys = Object.keys(item.binary || {});\nif (binaryKeys.length === 0) {\n  return [{ json: { valid: false, error: 'No raw body binary data found — check Raw Body option on Webhook node' } }];\n}\nconst rawBodyBase64 = item.binary[binaryKeys[0]].data;\nconst rawBody = Buffer.from(rawBodyBase64, 'base64').toString('utf8');\n\n// Parse Stripe's header format\nconst parts = Object.fromEntries(\n  sigHeader.split(',').map(part => part.split('='))\n);\nconst timestamp = parts.t;\nconst receivedSig = parts.v1;\n\n// Reject old events to prevent replay attacks (5 minute tolerance)\nconst currentTime = Math.floor(Date.now() / 1000);\nconst isTooOld = Math.abs(currentTime - parseInt(timestamp)) > 300;\n\n// Recompute the signature ourselves\nconst signedPayload = `${timestamp}.${rawBody}`;\nconst expectedSig = crypto\n  .createHmac('sha256', WEBHOOK_SECRET)\n  .update(signedPayload, 'utf8')\n  .digest('hex');\n\n// Timing-safe comparison to avoid timing-attack side channels\nconst sigsMatch = receivedSig && expectedSig.length === receivedSig.length &&\n  crypto.timingSafeEqual(Buffer.from(expectedSig), Buffer.from(receivedSig));\n\nif (!sigsMatch || isTooOld) {\n  return [{\n    json: {\n      valid: false,\n      error: isTooOld ? 'Timestamp too old (possible replay)' : 'Signature mismatch'\n    }\n  }];\n}\n\n// Signature confirmed - pass the actual event through\nconst event = JSON.parse(rawBody);\nreturn [{ json: { valid: true, event } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -368
      ],
      "id": "b2777120-55b1-4d0d-8be3-6a797c5ab6d8",
      "name": "Verify Signature"
    },
    {
      "parameters": {
        "jsCode": "const event = $('Verify Signature').first().json.event;\nconst eventType = event.type;\nconst paymentIntent = event.data.object;\n\nconst isSuccess = eventType === 'payment_intent.succeeded';\nconst isFailure = eventType === 'payment_intent.payment_failed';\n\nreturn [{\n  json: {\n    eventId: event.id,\n    eventType,\n    isSuccess,\n    isFailure,\n    amount: paymentIntent.amount / 100,\n    currency: paymentIntent.currency.toUpperCase(),\n    customerEmail: paymentIntent.receipt_email || $env.TEST_FALLBACK_EMAIL || null,\n    failureReason: isFailure ? paymentIntent.last_payment_error?.message : null,\n    createdAt: new Date(event.created * 1000).toISOString()\n  }\n}];"
      },
